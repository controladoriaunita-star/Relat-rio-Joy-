# Copie para .env (local) e cadastre as mesmas chaves em Vercel › Settings › Environment Variables.
# Segredos (senha do banco, service role, client secret) NUNCA entram neste arquivo.

# Supabase › Project Settings › Database › Connection string › Transaction pooler (porta 6543)
DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres

# Supabase › Project Settings › API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Só para projetos que assinam o JWT com segredo HS256 (legado). Com chaves JWKS, deixe vazio.
SUPABASE_JWT_SECRET=

# Microsoft Graph (app "Apresentação Joy+" no Entra ID)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_DRIVE_ID=
GRAPH_ITEM_ID=

# Desenvolvimento sem Supabase (SQLite + seletor de perfil). Nunca ative em produção.
# APORTE_AUTH_LOCAL=1
