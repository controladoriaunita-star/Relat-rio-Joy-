# Copie para .env (local) e cadastre as mesmas chaves em Vercel › Settings › Environment Variables.
# Segredos (senha do banco, service role, client secret) NUNCA entram neste arquivo.

# Supabase › Project Settings › Database › Connection string › Transaction pooler (porta 6543)
DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres

# Supabase › Project Settings › API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Só para projetos que assinam o JWT com segredo HS256 (legado). Com chaves JWKS, deixe vazio.
SUPABASE_JWT_SECRET=

# Microsoft Graph (app "Apresentação Joy+" no Entra ID)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_DRIVE_ID=
GRAPH_ITEM_ID=

# Login Microsoft 365 (Entra ID). AUTH_MODE=entra troca o e-mail/senha do Supabase pelo botão
# "Entrar com Microsoft 365"; vazio = login do Supabase como antes. O usuário continua cadastrado
# em API's › Usuários (o e-mail precisa bater). No app do Entra: redirect URI
# <APP_URL>/api/auth/microsoft/callback (Web) e permissões delegadas openid, profile, email,
# offline_access e Mail.Send (o Resumo por e-mail sai da caixa de quem está logado).
AUTH_MODE=
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_DOMINIO=unitaengenharia.com.br
# Endereço público do app (ex.: https://aporte.vercel.app); vazio = o da própria requisição.
APP_URL=
# Assina o cookie de sessão e cifra o token de e-mail. Mínimo de 32 caracteres aleatórios.
SESSAO_SEGREDO=

# Login: 1/ausente = tela de login do Supabase (padrão); 0 = acesso direto com o perfil abaixo.
APORTE_LOGIN_ATIVO=1
APORTE_PERFIL_SEM_LOGIN=admin

# Desenvolvimento sem Supabase (SQLite + seletor de perfil). Nunca ative em produção.
# APORTE_AUTH_LOCAL=1
